# Deployment settings: cp deploy.env.example deploy.env, fill in, run ./scripts/deploy.sh
PROJECT_ID=my-gcp-project
REGION=us-central1
SERVICE=google-mcp-hub
# Only these Google accounts can sign in to the hub and authorise Claude.
OWNER_EMAILS=you@gmail.com
# Leave empty on the first run; the script tells you how to create the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
