{
  "name": "google-mcp-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted MCP server that gives Claude access to several Google accounts, gated by Google sign-in.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file=.env --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
