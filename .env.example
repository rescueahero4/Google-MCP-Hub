# Local development: cp .env.example .env, then `npm run dev`.
BASE_URL=http://localhost:8080
# Google emails allowed to use this hub (comma separated).
OWNER_EMAILS=you@gmail.com
# From your Google OAuth client. Add http://localhost:8080/oauth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
HUB_SIGNING_KEY=
# Local runs keep accounts in a JSON file.
STORE=file
DATA_FILE=.data/accounts.json
